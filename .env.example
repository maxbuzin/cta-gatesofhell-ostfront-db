# App (Vercel / local). Production: pooled Neon host + user goh_app_ro only.
DATABASE_URL=

# drizzle-kit only (never on Vercel). Neon owner / unpooled URL.
DATABASE_URL_OWNER=

# ETL only (never on Vercel; GitHub Environment production-data or local .env.local).
# Must be role goh_etl — owner and goh_app_ro are refused.
DATABASE_URL_ETL=

# Optional: Google service account JSON string for read-only Sheets API.
# Scope: https://www.googleapis.com/auth/spreadsheets.readonly
# Store only in GitHub Environment production-data — never a personal login, never commit.
GOOGLE_SERVICE_ACCOUNT_JSON=

REVALIDATE_SECRET=
NEXT_PUBLIC_SITE_URL=
# Optional alias used by ETL post-write revalidate (falls back to NEXT_PUBLIC_SITE_URL).
SITE_URL=
