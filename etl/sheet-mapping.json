    "unit_stats.source_id": "row Source column if present, else the google_sheet source",
    "units.search_name": "lower(unaccent(name))"
  },
  "rules": {
    "skipUnitStatsWhenEmpty": true,
    "numericParse": "^-?\\d+(\\.\\d+)?$ (no thousands separators seen); non-numeric → null + warning",
    "outOfRange": "DB-overflow → null + warning; outside plausible min/max → keep + warning",
    "smallintRound": "armor columns are smallint: round, keep exact value in unit_stats.extra.*_armor_max_mm",
    "yesNo": "Yes→1, No→0 (unit_stats.extra is Record<string, number|string>)",
    "skipCostsWhenNotesMatch": "unit not specified",
    "blankNameOrUnknownFaction": "reject row"
  },
  "unitTypeRules": {
    "single_soldier": "Infantry: IE id starts with \"single_\" or Squad size = 1 → infantry_unit, else infantry_squad",
    "td_vs_spg": {
      "spgIf": [
        "Main Specialty contains \"Long-Range Artillery\"",
        "Unit matches /\\b(HMC|GMC|SPG|SU-?(76|122|152)|ISU-?(122|152)|Wespe|Hummel|Sturmpanzer|Brummb[aä]r|Grille|Bison|Sexton|Priest|Bishop|Sturmtiger|Karl)\\b/i"
      ],
      "else": "tank_destroyer"
    },
    "armored_car_vs_light": {
      "armoredCarIf": "Unit matches /(armou?red car|\\bBA-\\d|\\bBA-?[0-9]+|Sd\\.? ?Kfz\\.? ?(221|222|223|231|232|234|247|260|261|263)\\b|\\bPuma\\b|\\bM8\\b|\\bM20\\b|Staghound|Daimler|Humber|Dingo|\\bAEC\\b|Marmon|Lynx|Otter|Rolls|\\bT17\\b|\\bM3A1 Scout|Panhard|\\bP204|Coventry)/i",
      "else": "light_vehicle"
    },
    "truck_vs_support": {
      "truckIf": "Unit matches /(truck|lorry|Blitz|Studebaker|\\bZIS\\b|ZIS-|GAZ-AA|GAZ-MM|Bedford|CCKW|Chevrolet|\\bFord\\b|Krupp|B[uü]ssing|\\bDodge\\b|\\bMorris\\b|\\bAustin\\b|\\bGMC\\b)/i",
      "else": "support_vehicle"
    },
    "type_column": "Mortars & Rockets: Type Mortar→mortar, Rocket→rocket",
    "needsDecision": "name-regex splits are heuristics; consider adding a Type column to the sheet or an override map"
  },
