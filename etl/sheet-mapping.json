  "slugRule": {
    "check": "^[a-z0-9][a-z0-9-]{0,79}$",
    "library": "@sindresorhus/slugify@3.0.1",
    "options": {
      "decamelize": false,
      "customReplacements": [
        [
          "&",
          " and "
        ],
        [
          "×",
          "x"
        ],
        [
          "+",
          " plus "
        ],
        [
          "*",
          " star "
        ]
      ]
    },
    "preprocess": "collapse whitespace, trim, strip trailing \"(snake_case_id)\" from Unit (kept as unit_stats.extra.ie_id)",
    "maxLength": 80,
    "truncate": "cut at last hyphen before 80 chars",
    "collisionSteps": [
      "1. base = slugify(name)",
      "2. if base is shared by units of >1 faction: append \"-<faction-slug>\" to every member of that group",
      "3. if still shared: append \"-<discriminator>\" (Infantry: slugify(era [+ doctrine unless \"Conquest research tree\"]); vehicles/guns: slugify(main gun))",
      "4. if still shared: append \"-2\", \"-3\" in sheet order"
    ],
    "stability": "Persist issued slugs in etl/slug-lock.json keyed by (tab, faction, name, discriminator); never re-derive an existing slug.",
    "sameRuleFor": [
      "factions.slug",
      "specialties.slug",
      "weapons.slug"
    ]
  },
  "identity": {
    "key": [
      "tab",
      "faction",
      "name (case-insensitive, whitespace-collapsed)"
    ],
    "exactDuplicate": "all raw cells identical → merge (skip later row)",
    "weaponVariant": "same key, differs only in weapon columns → separate units, slug discriminated by main gun",
    "infantryVariant": "same key in Infantry → separate units (era/doctrine/source differ)",
    "conflict": "same key, differs in non-weapon columns → reject later row for manual review"
  },
